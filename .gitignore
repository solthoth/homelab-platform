# Hyper-V cluster-setup.ps1 runtime output
infrastructure/hyper-v/logs/
infrastructure/hyper-v/state/
talosconfig/

# Large binaries that don't belong in git
*.vhdx
*.vhd
*.iso

# Kustomize's helmCharts: field pulls the chart source into charts/<name>-<version>/
# next to the kustomization.yaml to render it, and doesn't clean up afterward --
# fully regenerable from kustomization.yaml's helmCharts: reference + version pin.
kubernetes/**/charts/
